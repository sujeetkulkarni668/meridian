# ==============================================================================
# MERIDIAN - The Autonomous Agent Economy for NEAR Protocol
# Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL for production / indexing; SQLite supported for local dev)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/meridian?schema=public
# Example for SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# AI Inference Providers
# Google Gemini (Primary provider - get key from https://aistudio.google.com/ or https://cloud.near.ai)
GEMINI_API_KEY=""

# xAI Grok (Optional secondary provider - get key from https://console.x.ai/)
GROK_API_KEY=""

# NEAR Protocol Configuration
# Network: 'testnet' (default for development/hackathon) or 'mainnet'
NEAR_NETWORK="testnet"

# NEAR RPC Node Endpoint
NEAR_RPC_URL="https://rpc.testnet.near.org"

# NEAR Contract ID deployed on Testnet
# Once deployed, set this to e.g. meridian_core.youraccount.testnet
NEAR_CONTRACT_ID=""

# Optional Backend Signer Account ID (for automated agent relayer actions)
# For web transactions, client-side NEAR Wallet Selector signing is preferred.
NEAR_ACCOUNT_ID=""

# Optional Backend Signer Private Key (ed25519:...)
# WARNING: NEVER commit real keys to Git or share in logs. Keep empty if using frontend wallet.
NEAR_PRIVATE_KEY=""

# Meridian Guard Security Policy Settings
# Maximum spending limit per agent task in NEAR
MAX_TASK_BUDGET_NEAR="50.0"
# Emergency circuit breaker pause flag (true / false)
EMERGENCY_PAUSE="false"

# Application Environment ('development' | 'production' | 'test')
NODE_ENV="development"
PORT="3000"
